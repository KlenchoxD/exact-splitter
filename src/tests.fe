use ingot::{
    ClaimForwarder,
    ExactSplitter,
    PayeeMsg,
    RejectingReceiver,
    ReentrantMsg,
    ReentrantReceiver,
    SplitterMsg,
    largest_remainder_shares,
    largest_remainder_shares_bounded,
}
use std::evm::{wei, Evm}

#[test]
fn bounded_allocator_handles_one_party_and_ignores_unused_slots() {
    let payouts = largest_remainder_shares_bounded(
        amount: 17,
        weights: [9, 0, 0, 0, 0, 0, 0, 0],
        count: 1,
    )

    assert!(payouts[0] == 17)
    assert!(payouts[1] == 0)
    assert!(payouts[7] == 0)
}

#[test]
fn bounded_allocator_supports_eight_parties_and_stable_ties() {
    let payouts = largest_remainder_shares_bounded(
        amount: 3,
        weights: [1, 1, 1, 1, 1, 1, 1, 1],
        count: 8,
    )

    assert!(payouts[0] == 1)
    assert!(payouts[1] == 1)
    assert!(payouts[2] == 1)
    assert!(payouts[3] == 0)
    assert!(payouts[7] == 0)
}

#[test]
fn largest_remainder_can_show_the_alabama_paradox_across_pool_sizes() {
    let weights = [1, 3, 3, 0, 0, 0, 0, 0]
    let three_units = largest_remainder_shares_bounded(amount: 3, weights: weights, count: 3)
    let four_units = largest_remainder_shares_bounded(amount: 4, weights: weights, count: 3)

    assert!(three_units[0] == 1)
    assert!(three_units[1] == 1)
    assert!(three_units[2] == 1)
    assert!(four_units[0] == 0)
    assert!(four_units[1] == 2)
    assert!(four_units[2] == 2)
}

#[test(should_revert)]
fn bounded_allocator_rejects_zero_party_count() {
    largest_remainder_shares_bounded(amount: 10, weights: [1, 0, 0, 0, 0, 0, 0, 0], count: 0)
}

#[test(should_revert)]
fn bounded_allocator_rejects_more_than_eight_parties() {
    largest_remainder_shares_bounded(amount: 10, weights: [1, 1, 1, 1, 1, 1, 1, 1], count: 9)
}

#[test]
fn equal_split_gives_remainder_to_first_payee_on_tie() {
    let (first, second, third) = largest_remainder_shares(
        amount: 7,
        weight_a: 1,
        weight_b: 1,
        weight_c: 1,
    )

    assert!(first == 3)
    assert!(second == 2)
    assert!(third == 2)
    assert!(first + second + third == 7)
}

#[test]
fn largest_fractional_remainder_gets_the_leftover_wei() {
    let (first, second, third) = largest_remainder_shares(
        amount: 7,
        weight_a: 3,
        weight_b: 1,
        weight_c: 1,
    )

    assert!(first == 4)
    assert!(second == 2)
    assert!(third == 1)
    assert!(first + second + third == 7)
}

#[test]
fn two_leftover_wei_follow_fraction_ranking_and_ties() {
    let (first_tie, second_tie, third_tie) = largest_remainder_shares(
        amount: 2,
        weight_a: 1,
        weight_b: 1,
        weight_c: 1,
    )
    assert!(first_tie == 1)
    assert!(second_tie == 1)
    assert!(third_tie == 0)

    let (first_b, second_b, third_b) = largest_remainder_shares(
        amount: 8,
        weight_a: 1,
        weight_b: 3,
        weight_c: 1,
    )
    assert!(first_b == 2)
    assert!(second_b == 5)
    assert!(third_b == 1)

    let (first_c, second_c, third_c) = largest_remainder_shares(
        amount: 8,
        weight_a: 1,
        weight_b: 1,
        weight_c: 3,
    )
    assert!(first_c == 2)
    assert!(second_c == 1)
    assert!(third_c == 5)
}

#[test]
fn weighted_split_matches_exact_ratios() {
    let (first, second, third) = largest_remainder_shares(
        amount: 100,
        weight_a: 2,
        weight_b: 3,
        weight_c: 5,
    )

    assert!(first == 20)
    assert!(second == 30)
    assert!(third == 50)
    assert!(first + second + third == 100)
}

#[test]
fn one_wei_pool_is_not_stranded() {
    let (first, second, third) = largest_remainder_shares(
        amount: 1,
        weight_a: 1,
        weight_b: 1,
        weight_c: 1,
    )

    assert!(first == 1)
    assert!(second == 0)
    assert!(third == 0)
    assert!(first + second + third == 1)
}

#[test]
fn maximum_u256_amount_does_not_overflow_intermediates() {
    let maximum: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
    let (first, second, third) = largest_remainder_shares(
        amount: maximum,
        weight_a: 499_999_999_999_999_999,
        weight_b: 500_000_000_000_000_000,
        weight_c: 1,
    )
    assert!(
        first == 57896044618658097595993403267027758503064007324132374166458807338316000780510,
    )
    assert!(
        second == 57896044618658097711785492504343953926634992332820282019728792003956564819967,
    )
    assert!(
        third == 115792089237316195423570985008687907853269984665640564039458,
    )
    assert!(first + second + third == maximum)
}

#[test(should_revert)]
fn zero_weight_is_rejected() {
    largest_remainder_shares(amount: 10, weight_a: 1, weight_b: 0, weight_c: 1)
}

#[test(should_revert)]
fn excessive_denominator_is_rejected() {
    largest_remainder_shares(
        amount: 10,
        weight_a: 1_000_000_000_000_000_000,
        weight_b: 1,
        weight_c: 1,
    )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn contract_finalizes_exact_shares_and_pays_contract_payee()
uses (evm: mut Evm)
{
    let creator = evm.address()
    let payee_b: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )

    let funded: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(7),
            message: SplitterMsg::Deposit {},
        )
    assert!(funded == wei(7))

    let finalized: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    assert!(finalized == wei(7))

    let creator_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: creator },
        )
    let second_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_b },
        )
    let third_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_c },
        )
    assert!(creator_due == wei(3))
    assert!(second_due == wei(2))
    assert!(third_due == wei(2))
    assert!(creator_due + second_due + third_due == wei(7))

    let paid: Wei = evm
        .call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(paid == wei(2))
    assert!(evm.balance(payee_b) == wei(2))
    let creator_due_after: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_b },
        )
    assert!(creator_due_after == wei(0))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn finalized_pool_rejects_new_deposits() uses (evm: mut Evm) {
    let creator = evm.address()
    let payee_b: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn only_creator_can_finalize() uses (evm: mut Evm) {
    let creator = evm.address()
    let forwarder: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, forwarder, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: forwarder,
            gas: 300_000,
            value: wei(0),
            message: PayeeMsg::FinalizeFrom { splitter },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn claim_cannot_be_replayed() uses (evm: mut Evm) {
    let creator = evm.address()
    let payee_b: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(3),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    let paid: Wei = evm
        .call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(paid == wei(1))
    let replay = evm
        .try_call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(!replay.success())
}

#[test(balance = 10_000_000_000_000_000_000)]
fn failed_receiver_transfer_preserves_claimable_amount() uses (evm: mut Evm) {
    let creator = evm.address()
    let rejecting: Address = evm.create2<RejectingReceiver>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, rejecting, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(3),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )

    let failed = evm
        .try_call(
            addr: rejecting,
            gas: 300_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(!failed.success())

    let still_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: rejecting },
        )
    assert!(still_due == wei(1))
}

#[test(balance = 10_000_000_000_000_000_000)]
fn reentrant_receiver_cannot_claim_twice() uses (evm: mut Evm) {
    let creator = evm.address()
    let reentrant: Address = evm.create2<ReentrantReceiver>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, reentrant, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(3),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )

    let paid: Wei = evm
        .call(
            addr: reentrant,
            gas: 500_000,
            value: wei(0),
            message: ReentrantMsg::ClaimFrom { splitter },
        )
    assert!(paid == wei(1))
    assert!(evm.balance(reentrant) == wei(1))

    let no_longer_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: reentrant },
        )
    assert!(no_longer_due == wei(0))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn zero_weight_payee_is_rejected() uses (evm: mut Evm) {
    let _: Address = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (Address::new(0xA0A), 1, Address::new(0xB0B), 0, Address::new(0xC0C), 1),
            salt: 0,
        )
}

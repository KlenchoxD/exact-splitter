use ingot::{ClaimForwarder, ExactSplitter, PayeeMsg, SplitterMsg, cumulative_amount, share_amount}
use std::evm::{wei, Evm}

#[test]
fn equal_split_assigns_every_remainder_unit() {
    let first = share_amount(
        amount: 7,
        previous_weight: 0,
        cumulative_weight: 1,
        total_weight: 3,
    )
    let second = share_amount(
        amount: 7,
        previous_weight: 1,
        cumulative_weight: 2,
        total_weight: 3,
    )
    let third = share_amount(
        amount: 7,
        previous_weight: 2,
        cumulative_weight: 3,
        total_weight: 3,
    )

    assert!(first == 2)
    assert!(second == 2)
    assert!(third == 3)
    assert!(first + second + third == 7)
}

#[test]
fn weighted_split_matches_exact_ratios() {
    let first = share_amount(
        amount: 100,
        previous_weight: 0,
        cumulative_weight: 2,
        total_weight: 10,
    )
    let second = share_amount(
        amount: 100,
        previous_weight: 2,
        cumulative_weight: 5,
        total_weight: 10,
    )
    let third = share_amount(
        amount: 100,
        previous_weight: 5,
        cumulative_weight: 10,
        total_weight: 10,
    )

    assert!(first == 20)
    assert!(second == 30)
    assert!(third == 50)
    assert!(first + second + third == 100)
}

#[test]
fn one_wei_pool_is_not_stranded() {
    let first = share_amount(
        amount: 1,
        previous_weight: 0,
        cumulative_weight: 1,
        total_weight: 3,
    )
    let second = share_amount(
        amount: 1,
        previous_weight: 1,
        cumulative_weight: 2,
        total_weight: 3,
    )
    let last = share_amount(
        amount: 1,
        previous_weight: 2,
        cumulative_weight: 3,
        total_weight: 3,
    )

    assert!(first == 0)
    assert!(second == 0)
    assert!(last == 1)
    assert!(first + second + last == 1)
}

#[test]
fn maximum_u256_amount_does_not_overflow_intermediates() {
    let maximum: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
    let first = share_amount(
        amount: maximum,
        previous_weight: 0,
        cumulative_weight: 499_999_999_999_999_999,
        total_weight: 1_000_000_000_000_000_000,
    )
    let second = share_amount(
        amount: maximum,
        previous_weight: 499_999_999_999_999_999,
        cumulative_weight: 1_000_000_000_000_000_000,
        total_weight: 1_000_000_000_000_000_000,
    )
    assert!(first + second == maximum)
}

#[test(should_revert)]
fn zero_total_weight_is_rejected() {
    cumulative_amount(amount: 10, prefix_weight: 0, total_weight: 0)
}

#[test(should_revert)]
fn reversed_weight_range_is_rejected() {
    share_amount(
        amount: 10,
        previous_weight: 2,
        cumulative_weight: 1,
        total_weight: 3,
    )
}

#[test(should_revert)]
fn excessive_denominator_is_rejected() {
    cumulative_amount(
        amount: 10,
        prefix_weight: 1_000_000_000_000_000_001,
        total_weight: 1_000_000_000_000_000_001,
    )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn contract_finalizes_exact_shares_and_pays_contract_payee()
uses (evm: mut Evm)
{
    let creator = evm.address()
    let payee_b: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )

    let funded: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(7),
            message: SplitterMsg::Deposit {},
        )
    assert!(funded == wei(7))

    let finalized: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    assert!(finalized == wei(7))

    let creator_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: creator },
        )
    let second_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_b },
        )
    let third_due: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_c },
        )
    assert!(creator_due == wei(2))
    assert!(second_due == wei(2))
    assert!(third_due == wei(3))
    assert!(creator_due + second_due + third_due == wei(7))

    let paid: Wei = evm
        .call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(paid == wei(2))
    assert!(evm.balance(payee_b) == wei(2))
    let creator_due_after: Wei = evm
        .call(
            addr: splitter,
            gas: 100_000,
            value: wei(0),
            message: SplitterMsg::Claimable { account: payee_b },
        )
    assert!(creator_due_after == wei(0))
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn finalized_pool_rejects_new_deposits() uses (evm: mut Evm) {
    let creator = evm.address()
    let payee_b: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn only_creator_can_finalize() uses (evm: mut Evm) {
    let creator = evm.address()
    let forwarder: Address = evm.create2<ClaimForwarder>(value: wei(0), args: (), salt: 1)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, forwarder, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(1),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: forwarder,
            gas: 300_000,
            value: wei(0),
            message: PayeeMsg::FinalizeFrom { splitter },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn claim_cannot_be_replayed() uses (evm: mut Evm) {
    let creator = evm.address()
    let payee_b = Address::new(0xB0B)
    let payee_c = Address::new(0xC0C)
    let splitter = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (creator, 1, payee_b, 1, payee_c, 1),
            salt: 0,
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 200_000,
            value: wei(3),
            message: SplitterMsg::Deposit {},
        )
    let _: Wei = evm
        .call(
            addr: splitter,
            gas: 300_000,
            value: wei(0),
            message: SplitterMsg::Finalize {},
        )
    let paid: Wei = evm
        .call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
    assert!(paid == wei(1))
    let _: Wei = evm
        .call(
            addr: payee_b,
            gas: 200_000,
            value: wei(0),
            message: PayeeMsg::ClaimFrom { splitter },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn zero_weight_payee_is_rejected() uses (evm: mut Evm) {
    let _: Address = evm
        .create2<ExactSplitter>(
            value: wei(0),
            args: (Address::new(0xA0A), 1, Address::new(0xB0B), 0, Address::new(0xC0C), 1),
            salt: 0,
        )
}

// Generated from demo/allocator-vectors.json. Do not edit manually.
use ingot::largest_remainder_shares

#[test]
fn shared_vector_one_party_u256_maximum() {
    let payouts = largest_remainder_shares(
        amount: 115_792_089_237_316_195_423_570_985_008_687_907_853_269_984_665_640_564_039_457_584_007_913_129_639_935,
        weights: [1],
    )
    assert!(
        payouts[0]
            == 115_792_089_237_316_195_423_570_985_008_687_907_853_269_984_665_640_564_039_457_584_007_913_129_639_935,
    )
}

#[test]
fn shared_vector_three_way_tie() {
    let payouts = largest_remainder_shares(amount: 7, weights: [1, 1, 1])
    assert!(payouts[0] == 3)
    assert!(payouts[1] == 2)
    assert!(payouts[2] == 2)
}

#[test]
fn shared_vector_eight_party_remainder_tie() {
    let payouts = largest_remainder_shares(amount: 13, weights: [1, 1, 1, 1, 1, 1, 1, 1])
    assert!(payouts[0] == 2)
    assert!(payouts[1] == 2)
    assert!(payouts[2] == 2)
    assert!(payouts[3] == 2)
    assert!(payouts[4] == 2)
    assert!(payouts[5] == 1)
    assert!(payouts[6] == 1)
    assert!(payouts[7] == 1)
}

#[test]
fn shared_vector_eight_party_maximum_total_weight() {
    let payouts = largest_remainder_shares(
        amount: 9,
        weights: [
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
            125_000_000_000_000_000,
        ],
    )
    assert!(payouts[0] == 2)
    assert!(payouts[1] == 1)
    assert!(payouts[2] == 1)
    assert!(payouts[3] == 1)
    assert!(payouts[4] == 1)
    assert!(payouts[5] == 1)
    assert!(payouts[6] == 1)
    assert!(payouts[7] == 1)
}

#[test]
fn shared_vector_alabama_paradox_three_wei() {
    let payouts = largest_remainder_shares(amount: 3, weights: [1, 3, 3])
    assert!(payouts[0] == 1)
    assert!(payouts[1] == 1)
    assert!(payouts[2] == 1)
}

#[test]
fn shared_vector_alabama_paradox_four_wei() {
    let payouts = largest_remainder_shares(amount: 4, weights: [1, 3, 3])
    assert!(payouts[0] == 0)
    assert!(payouts[1] == 2)
    assert!(payouts[2] == 2)
}

#[test]
fn shared_vector_u256_maximum_with_large_denominator() {
    let payouts = largest_remainder_shares(
        amount: 115_792_089_237_316_195_423_570_985_008_687_907_853_269_984_665_640_564_039_457_584_007_913_129_639_935,
        weights: [499_999_999_999_999_999, 500_000_000_000_000_000, 1],
    )
    assert!(
        payouts[0]
            == 57_896_044_618_658_097_595_993_403_267_027_758_503_064_007_324_132_374_166_458_807_338_316_000_780_510,
    )
    assert!(
        payouts[1]
            == 57_896_044_618_658_097_711_785_492_504_343_953_926_634_992_332_820_282_019_728_792_003_956_564_819_967,
    )
    assert!(
        payouts[2]
            == 115_792_089_237_316_195_423_570_985_008_687_907_853_269_984_665_640_564_039_458,
    )
}

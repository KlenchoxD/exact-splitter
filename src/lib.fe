use std::abi::sol
use std::evm::StorageMap
use std::evm::wei

/// The weight total is capped so every remainder-times-weight intermediate
/// stays below 10^36, even when `amount` is the largest u256 value.
pub const MAX_TOTAL_WEIGHT: u256 = 1_000_000_000_000_000_000
pub const MAX_ALLOCATION_PARTIES: usize = 8

/// Splits an amount among 1 to 8 parties using largest remainders.
///
/// Only the first `count` weights are read. Unused payout slots are zero.
/// Equal fractional remainders are awarded in ascending index order.
pub fn largest_remainder_shares_bounded(
    amount: u256,
    weights: [u256; 8],
    count: usize,
) -> [u256; 8] {
    assert!(
        count > 0 && count <= MAX_ALLOCATION_PARTIES,
        "Invalid party count",
    )

    var total_weight: u256 = 0
    for index in 0 .. count {
        let weight = weights[index]
        assert!(weight > 0, "Weight is zero")
        assert!(
            weight <= MAX_TOTAL_WEIGHT - total_weight,
            "Weight total too large",
        )
        total_weight += weight
    }

    let quotient = amount / total_weight
    let remainder = amount % total_weight
    var payouts: [u256; 8] = [0; 8]
    var fractions: [u256; 8] = [0; 8]
    var selected: [bool; 8] = [false; 8]
    var base_total: u256 = 0

    for index in 0 .. count {
        let weight = weights[index]
        let base = quotient * weight + (remainder * weight) / total_weight
        payouts[index] = base
        fractions[index] = (remainder * weight) % total_weight
        base_total += base
    }

    let leftover = amount - base_total
    var awarded: u256 = 0
    for _ in 0 .. count {
        if awarded < leftover {
            var found = false
            var best_index: usize = 0
            var best_fraction: u256 = 0
            for index in 0 .. count {
                if !selected[index] && (!found || fractions[index] > best_fraction) {
                    found = true
                    best_index = index
                    best_fraction = fractions[index]
                }
            }
            assert!(found, "No unselected party")
            selected[best_index] = true
            payouts[best_index] += 1
            awarded += 1
        }
    }

    payouts
}

/// Splits an amount by weight using the largest-remainder method.
///
/// Quotient/remainder decomposition avoids multiplying the full amount by a
/// weight. Each leftover wei goes to the largest fractional remainder; ties
/// are resolved by argument order (A, then B, then C). The results sum exactly
/// to `amount`.
pub fn largest_remainder_shares(amount: u256, weight_a: u256, weight_b: u256, weight_c: u256) -> (
    u256,
    u256,
    u256,
) {
    let payouts = largest_remainder_shares_bounded(
        amount: amount,
        weights: [weight_a, weight_b, weight_c, 0, 0, 0, 0, 0],
        count: 3,
    )
    (payouts[0], payouts[1], payouts[2])
}

msg SplitterMsg {
    #[selector = sol("deposit()")]
    Deposit -> Wei,
    #[selector = sol("finalize()")]
    Finalize -> Wei,
    #[selector = sol("claim()")]
    Claim -> Wei,
    #[selector = sol("claimable(address)")]
    Claimable { account: Address } -> Wei,
    #[selector = sol("funded()")]
    Funded -> Wei,
}

msg PayeeMsg {
    #[selector = sol("claimFrom(address)")]
    ClaimFrom { splitter: Address } -> Wei,
    #[selector = sol("finalizeFrom(address)")]
    FinalizeFrom { splitter: Address } -> Wei,
}

/// Minimal forwarding recipient used to demonstrate contract payees and to
/// make the pull-claim path testable with an EVM receiver that accepts ETH.
pub contract ClaimForwarder uses (ctx: Ctx, call: mut Call) {
    mut received: Wei,

    init() uses (mut received) { received = Wei::zero() }

    recv PayeeMsg {
        ClaimFrom { splitter } -> Wei uses (ctx, call) {
            splitter.call(SplitterMsg::Claim {})
        }

        FinalizeFrom { splitter } -> Wei uses (call) {
            splitter.call(SplitterMsg::Finalize {})
        }
    }

    recv {
        #[payable]
        _ uses (ctx, mut received) {
            received += ctx.value()
        }
    }
}

#[event]
struct Deposited {
    #[indexed]
    contributor: Address,
    amount: Wei,
    total: Wei,
}

#[event]
struct Finalized { total: Wei, payee_a_amount: Wei, payee_b_amount: Wei, payee_c_amount: Wei }

#[event]
struct Claimed {
    #[indexed]
    payee: Address,
    amount: Wei,
}

/// A one-shot ETH pool that allocates every wei across three fixed payees.
///
/// The creator freezes contributions with `finalize`; each payee withdraws
/// separately. Settlement uses largest remainders, so each wei goes to the
/// payee whose fractional share is largest; ties follow deployment order.
pub contract ExactSplitter uses (ctx: Ctx, call: mut Call, log: mut Log) {
    creator: Address,
    payee_a: Address,
    payee_b: Address,
    payee_c: Address,
    weight_a: u256,
    weight_b: u256,
    total_weight: u256,
    mut total_funded: Wei,
    mut claimable: StorageMap<Address, Wei>,
    mut is_finalized: bool,

    init(
        payee_a_value: Address,
        weight_a_value: u256,
        payee_b_value: Address,
        weight_b_value: u256,
        payee_c_value: Address,
        weight_c_value: u256,
    )
    uses (
        ctx,
        mut creator,
        mut payee_a,
        mut payee_b,
        mut payee_c,
        mut weight_a,
        mut weight_b,
        mut total_weight,
        mut total_funded,
        mut is_finalized,
    )
    {
        assert!(payee_a_value != Address::zero(), "Zero payee")
        assert!(payee_b_value != Address::zero(), "Zero payee")
        assert!(payee_c_value != Address::zero(), "Zero payee")
        assert!(payee_a_value != payee_b_value, "Payees must be unique")
        assert!(payee_a_value != payee_c_value, "Payees must be unique")
        assert!(payee_b_value != payee_c_value, "Payees must be unique")
        assert!(weight_a_value > 0, "Weight is zero")
        assert!(weight_b_value > 0, "Weight is zero")
        assert!(weight_c_value > 0, "Weight is zero")
        let weights = weight_a_value + weight_b_value + weight_c_value
        assert!(weights <= MAX_TOTAL_WEIGHT, "Weight total too large")

        creator = ctx.caller()
        payee_a = payee_a_value
        payee_b = payee_b_value
        payee_c = payee_c_value
        weight_a = weight_a_value
        weight_b = weight_b_value
        total_weight = weights
        total_funded = Wei::zero()
        is_finalized = false
    }

    recv SplitterMsg {
        #[payable]
        Deposit -> Wei uses (ctx, mut total_funded, is_finalized, mut log) {
            assert!(!is_finalized, "Pool is finalized")
            let amount = ctx.value()
            assert!(amount > Wei::zero(), "Deposit is zero")
            total_funded += amount
            log.emit(
                Deposited { contributor: ctx.caller(), amount, total: total_funded },
            )
            total_funded
        }

        Finalize -> Wei uses (
            ctx,
            creator,
            payee_a,
            payee_b,
            payee_c,
            weight_a,
            weight_b,
            total_weight,
            total_funded,
            mut claimable,
            mut is_finalized,
            mut log,
        ) {
            assert!(ctx.caller() == creator, "Only creator can finalize")
            assert!(!is_finalized, "Already finalized")
            assert!(total_funded > Wei::zero(), "Pool is empty")

            let amount = total_funded.as_wei()
            let (amount_a, amount_b, amount_c) = largest_remainder_shares(
                amount: amount,
                weight_a: weight_a,
                weight_b: weight_b,
                weight_c: total_weight - weight_a - weight_b,
            )
            let payout_a = wei(amount_a)
            let payout_b = wei(amount_b)
            let payout_c = wei(amount_c)

            claimable.set(key: payee_a, value: payout_a)
            claimable.set(key: payee_b, value: payout_b)
            claimable.set(key: payee_c, value: payout_c)
            is_finalized = true

            log.emit(
                Finalized {
                    total: total_funded,
                    payee_a_amount: payout_a,
                    payee_b_amount: payout_b,
                    payee_c_amount: payout_c,
                },
            )
            total_funded
        }

        Claim -> Wei uses (ctx, mut call, mut claimable, is_finalized, mut log) {
            assert!(is_finalized, "Pool is not finalized")
            let payee = ctx.caller()
            let amount = claimable.get(key: payee)
            assert!(amount > Wei::zero(), "Nothing to claim")

            // Clear the entitlement before the external call to block reentry.
            claimable.set(key: payee, value: Wei::zero())
            assert!(
                call.send_value(addr: payee, gas: ctx.gas(), value: amount).success(),
                "Payment failed",
            )
            log.emit(Claimed { payee, amount })
            amount
        }

        Claimable { account } -> Wei uses (claimable) {
            claimable.get(key: account)
        }

        Funded -> Wei uses (total_funded) {
            total_funded
        }
    }
}
